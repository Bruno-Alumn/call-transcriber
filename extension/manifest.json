{
  "manifest_version": 3,
  "name": "Discord Transcriber",
  "version": "2.9",
  "description": "Transcribes each person in a Discord voice call separately, locally.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://discord.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Discord Transcriber" },
  "content_scripts": [
    { "matches": ["https://discord.com/*"], "js": ["page-hook.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://discord.com/*"], "js": ["content.js"], "run_at": "document_start" }
  ]
}
